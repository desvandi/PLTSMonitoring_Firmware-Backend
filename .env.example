# Environment variables for PLTS Monitor firmware
# Brief §98: NEVER commit real secrets. Copy to secrets.h and fill in.

# MQTT Broker (production — TLS 8883/8884)
MQTT_BROKER_HOST=broker.yourdomain.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=plts-device-001
MQTT_PASSWORD=<strong-32-char-password>
MQTT_ROOT_CA=<PEM of broker's CA cert, \n-escaped>

# CORS (production — non-wildcard)
ALLOWED_CORS_ORIGINS=https://plts.yourdomain.com

# OTA Ed25519 (generate with: python3 scripts/sign_firmware.py --gen-keys)
OTA_ED25519_PUBLIC_KEY_HEX=<64 hex chars from sign_firmware.py>
OTA_HTTPS_ROOT_CA=<PEM of DigiCert/Let's Encrypt root CA, \n-escaped>

# Google Apps Script
GAS_INSIGHTS_URL=https://script.google.com/macros/s/<id>/exec

# Google Sheets (for GAS Script Properties, not firmware)
SHEET_ID=<your Google Sheet ID>

# Gemini AI (for GAS Script Properties)
GEMINI_API_KEY=<your Gemini API key>

# Per-device HMAC secret (for GAS Script Properties)
# Generated by ESP32 at first boot — printed to Serial ONCE
DEVICE_<DEVICEID>_SECRET=<64 hex chars from ESP32 first boot>
