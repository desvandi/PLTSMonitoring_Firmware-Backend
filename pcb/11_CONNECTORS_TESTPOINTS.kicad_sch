	(text "J_EXP — HEADER EKSPANSI 7-PIN 2,54 (M5 audit): 1=3V3 · 2=GND (DGND,\n  zona digital — konsisten J_PROGRAM/J_I2C_EXP) · 3=GPIO13 · 4=GPIO23\n  · 5=GPIO33 (ADC1, bidirectional) · 6=GPIO36/SENSOR_VP · 7=GPIO39/\n  SENSOR_VN. GPIO36 & GPIO39 = INPUT-ONLY (ADC1) — firmware DILARANG\n  drive-out; semua kanal ADC ekspansi di ADC1 (aman saat WiFi aktif).\n  Jalur = zone DIGITAL (net class ter-assign S2); pin pasif konektor\n  memenuhi ERC input-pin (preseden U1.6 S3)."
		(exclude_from_sim no)
		(at 46 145 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "e6284f7f-478f-4402-924a-d483840c5c06")	)
